{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "margin-notes",
    "version": "0.1.1",
    "identifier": "com.marginnotes.ai",
    "build": {
        "frontendDist": "../out",
        "devUrl": "http://localhost:3118",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },

    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Margin Notes",
                "width": 1100,
                "height": 700,
                "resizable": true,
                "fullscreen": false,
                "theme": "Light",
                "decorations": true
            },
            {
                "label": "floating-indicator",
                "title": "Recording Indicator",
                "url": "/floating-indicator",
                "width": 200,
                "height": 80,
                "resizable": false,
                "fullscreen": false,
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "visible": false,
                "focus": false,
                "acceptFirstMouse": false
            }
        ],
        "macOSPrivateApi": true,
        "security": {
            "csp": {
                "default-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' asset: https://asset.localhost data:",
                "connect-src": "'self' http://localhost:11434 http://localhost:5167 http://localhost:8178 https://api.ollama.ai"
            },
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$APPDATA/**"
                ]
            },
            "capabilities": [
                {
                    "identifier": "main",
                    "description": "Main window capability with file system and media access",
                    "windows": ["main"],
                    "permissions": [
                        "fs:default",
                        "fs:allow-read-file",
                        "fs:read-all",
                        "fs:write-all",
                        "fs:allow-app-read",
                        "fs:allow-app-write",
                        "fs:allow-download-write",
                        "fs:allow-download-read",
                        "fs:scope-download",
                        "core:path:default",
                        "core:event:default",
                        "core:window:default",
                        "core:app:default",
                        "core:resources:default",
                        "core:menu:default",
                        "core:tray:default",
                        "core:window:allow-set-title",
                        "store:default",
                        "notification:default",
                        "notification:allow-is-permission-granted",
                        "updater:default",
                        {
                            "identifier": "fs:scope",
                            "allow": [{ "path": "$APPDATA/*" }]
                        }
                    ]
                },
                {
                    "identifier": "floating-indicator",
                    "description": "Floating indicator window capability",
                    "windows": ["floating-indicator"],
                    "permissions": [
                        "core:event:default",
                        "core:window:default",
                        "core:window:allow-show",
                        "core:window:allow-hide",
                        "core:window:allow-set-always-on-top",
                        "core:window:allow-set-position",
                        "core:window:allow-set-size"
                    ]
                }
            ]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/icon.png",
            "icons/app_icon.icns",
            "icons/app_icon.ico"
        ],
        "resources": [
            "templates/*.json"
        ]
    }
}